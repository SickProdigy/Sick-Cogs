Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # The cog and static navigation use stable extensionless public routes.
  RewriteRule ^recovery/?$ recovery.html [L]
  RewriteRule ^security/?$ security.html [L]
  RewriteRule ^session/([A-Za-z0-9_-]{32,128})/?$ api/session-start.php?token=$1 [L,QSA]
  RewriteRule ^oauth/callback/?$ api/oauth-callback.php [L,QSA]
  RewriteRule ^session/?$ session.html [L]
  RewriteRule ^setup/?$ setup/index.php [L]
</IfModule>

